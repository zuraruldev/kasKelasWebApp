# Environment variables & secret keys
.env
.env.*
!.env.example
*.env
*.local

# IDE & AI Agent configurations with sensitive credentials/tokens
.vscode/
.cursor/
claude_desktop_config.json
.claude/
.agents/
.antigravity/

# Superpowers plans, specs, and execution ledgers
.superpowers/
superpowers/
docs/superpowers/
*.plan.md
sdd/

# Next.js build output
.next/
out/
next-env.d.ts

# Dependencies & Build artifacts
node_modules/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini

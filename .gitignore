# Environment variables & secret keys
.env
.env.*
!.env.example
*.env
*.local

# IDE & AI Agent configurations with sensitive credentials/tokens
.vscode/mcp.json
.cursor/mcp.json
claude_desktop_config.json
.superpowers/

# Next.js build output
.next/
out/
next-env.d.ts

# Dependencies & Build artifacts
node_modules/
dist/
build/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Operating System Files
.DS_Store
Thumbs.db
Desktop.ini
